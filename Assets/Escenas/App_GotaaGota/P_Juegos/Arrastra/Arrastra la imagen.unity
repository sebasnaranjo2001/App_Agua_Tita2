MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 257814007}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c1c6d8ac272a544ab20348e137e26e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManagerDrag
  fases:
  - textos:
    - Cerrar el grifo mientras te cepillas los dientes
    - Usar la lavadora solo con carga completa
    - Reutilizar el agua de lavar frutas y verduras para regar plantas
    imagenes:
    - {fileID: 4084148893081383880, guid: b9976bd0b56d0bd469a29c18e9fbe6b8, type: 3}
    - {fileID: -1604835014188566973, guid: a8dbcc52b46c1e44ba507d904d289a64, type: 3}
    - {fileID: 6467721386649028742, guid: 34768f8a6fe96864e93f6f2e001cfcbb, type: 3}
  - textos:
    - Instalar regaderas ahorradoras
    - "Reparar fugas en grifos y tuber\xEDas  "
    - Colocar una botella llena dentro del tanque del inodoro para reducir consumo
    imagenes:
    - {fileID: -7580932879190438459, guid: b9cb072948d7cda4ebfc3dfb0e3cfe80, type: 3}
    - {fileID: -3680255804181331574, guid: 54ebac39ba8bdae49bdd6a5bbf0fbd67, type: 3}
    - {fileID: -5215909844245504582, guid: 717dd3f2d2ce41d4a92178ade3d5ad69, type: 3}
  - textos:
    - "Regar las plantas temprano en la ma\xF1ana o al atardecer"
    - Usar un balde en lugar de la manguera para lavar el auto
    - "Acumular agua de lluvia para uso dom\xE9stico"
    imagenes:
    - {fileID: -5438089872657478894, guid: b4d857d9f5e267047944507ab7caffc8, type: 3}
    - {fileID: -5926332241297552561, guid: 847362af9f92335419f0740df30c6bd4, type: 3}
    - {fileID: -4887834873565688497, guid: 1dec9bf58ab02cf42ad571959f7097b7, type: 3}
  - textos:
    - Descongelar los alimentos para evitar usar agua
    - Barrer calles ayuda a evitar utilizar agua
    - Utilizar un tazon para lavar frutas y evitar desperdicio de agua
    imagenes:
    - {fileID: -3877566605634787203, guid: f0c84189f95862749ab38d3a0a19e06d, type: 3}
    - {fileID: 1327610316918547544, guid: 1bbde23de8626df489953e4ab1d52e25, type: 3}
    - {fileID: 5537007264794611617, guid: 4063e389d38a9914e9a42854649f18c9, type: 3}
  - textos:
    - Usar una cubeta ayuda a controlar el uso del agua
    - Un vaso es suficiente para lavarse los dientes
    - Instalar y revisar medidores ayuda a descubrir fugas ocultas
    imagenes:
    - {fileID: -3698478921794179634, guid: 3680eaa04a316504b863f0d639055e70, type: 3}
    - {fileID: 1256048416073334640, guid: 14669ca50911fba41a11543b7eef273f, type: 3}
    - {fileID: 4398110633819805978, guid: 780bbc845848bba45811a80de1ff110a, type: 3}
