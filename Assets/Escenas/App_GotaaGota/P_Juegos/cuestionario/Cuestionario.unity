  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b839579855b47844499ec75b87720074, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  preguntas:
  - pregunta: "\xBFCu\xE1l es la mejor forma de ahorrar agua al cepillarse los dientes? "
    respuestas:
    - "Usar m\xE1s agua al limpiar"
    - Cepillarse rapido sin cerrar la llave
    - Usar un vaso con agua
    respuestaCorrecta: 2
    imagen: {fileID: 7083995959121472022, guid: 5ad8fbabb3b61ff48851a5146e186833, type: 3}
  - pregunta: "\xBFQu\xE9 acci\xF3n ayuda m\xE1s a reducir el consumo de agua en
      la ducha? "
    respuestas:
    - Tomar duchas largas
    - 'Cerrar la llave mientras me enjabono '
    - Usar agua muy caliente
    respuestaCorrecta: 1
    imagen: {fileID: 5671885412947734317, guid: cacb29b83015c9e44866489c54285ac4, type: 3}
  - pregunta: "\xBFCu\xE1l de estas pr\xE1cticas es m\xE1s sostenible para regar
      plantas?"
    respuestas:
    - "Regar al mediod\xEDa"
    - Usar manguera sin control
    - "Regar en la noche o temprano en la ma\xF1ana"
    respuestaCorrecta: 2
    imagen: {fileID: 6408750344107933782, guid: 56303decc388a944cb7dd54475d8b89b, type: 3}
  - pregunta: "\xBFQu\xE9 se debe hacer si se detecta una fuga de agua en casa? "
    respuestas:
    - Repararla lo antes posible
    - "Usar m\xE1s agua para tapar la fuga"
    - Ignorarla
    respuestaCorrecta: 0
    imagen: {fileID: 6575279016644315727, guid: b61476e1e2cf80148bb4a404597baa7f, type: 3}
  - pregunta: "\xBFCu\xE1l es la mejor manera de usar la lavadora? "
    respuestas:
    - Usar con poca ropa
    - Usarla en la noche
    - Usarla con carga llena
    respuestaCorrecta: 2
    imagen: {fileID: -3133945157015180576, guid: 3d5959215b979c1419eb5abbc917b524, type: 3}
