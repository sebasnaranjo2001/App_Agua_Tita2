  m_Script: {fileID: 11500000, guid: b714a52eec0189f4ea0e44bcb651af7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ManejadorSwiper
  contenedor: {fileID: 262763954}
  tarjetas:
  - {fileID: 411018200}
  - {fileID: 1044323806}
  - {fileID: 948600321}
  frasesSabiasQue:
  - "\xBFDejar la llave abierta mientras te lavas los dientes consume unos 12 litros
    por minuto? Cerrarla equivale a ahorrar el agua de 6 botellas grandes en un solo
    cepillado."
  - "\xBFUna ducha de 10 minutos gasta hasta 200 litros de agua? Reducirla a solo
    5 minutos salva lo suficiente para que una persona beba durante todo un mes."
  - "\xBFTu inodoro usa unos 10 litros en cada descarga? Usar la papelera para la
    basura en lugar del retrete ahorra cientos de litros de agua limpia cada semana."
  - "\xBFLavar los platos con la llave abierta gasta unos 60 litros? Usar un recipiente
    para enjabonarlos y otro para enjuagarlos reduce ese enorme consumo a menos de
    la mitad."
  - "\xBFUna llave que gotea desperdicia hasta 30 litros de agua al d\xEDa? Arreglarla
    equivale a recuperar m\xE1s de 15 botellas grandes de agua pura diariamente en
    tu hogar."
  - "\xBFCerrar la llave de la ducha mientras te enjabonas el cabello ahorra hasta
    50 litros? Es el equivalente a todo lo que bebe tu familia entera durante tres
    d\xEDas."
  - "\xBFRecoger agua de lluvia en baldes es una pr\xE1ctica olvidada? Esa agua gratuita
    es perfecta para lavar pisos, limpiar exteriores o regar el jard\xEDn sin usar
    agua potable."
  textoSabiasQue: {fileID: 764134136}
  puntos:
  - {fileID: 487366524}
  - {fileID: 450737314}
  - {fileID: 2077419954}
  colorActivo: {r: 0.101960786, g: 0.22745098, b: 0.35686275, a: 1}
  colorInactivo: {r: 0.9019608, g: 0.92941177, b: 0.9607843, a: 1}
  "tama\xF1oPuntoActivo": 60
  "tama\xF1oPuntoInactivo": 40
  nombresDeContenidos:
  - Noticia1
  - Video
  - Noticia2
  - Noticia3
  tiempoAutoDesliz: 6
  sensibilidadSwipe: 20
  panelDetallesGeneral: {fileID: 314963590}
  contenedorContenidosDetalles: {fileID: 1472503566}
